OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MASSIVE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FXMACRODATA_API_KEY=
SLACK_WEBHOOK_URL=
GMAIL_APP_PASSWORD=
# Required for email alerts (no built-in default address).
AI_FLOOR_ALERT_EMAIL_FROM=
AI_FLOOR_ALERT_EMAIL_TO=
# Public https base URL of the dashboard for alert links (?page=floor); unset = RENDER_EXTERNAL_URL, else no buttons
AI_FLOOR_PUBLIC_URL=
# Optional public https .png shown as a small Floor thumbnail in the Slack alerts (empty = no image; Slack drops a
# message whose image cannot be downloaded, so only set a URL that is publicly reachable).
AI_FLOOR_ALERT_IMAGE_URL=
# At least 12 characters; use a long random value.
AI_FLOOR_DASHBOARD_PASSWORD=
# Optional; default 28800 (8 h), allowed 300..604800.
AI_FLOOR_DASHBOARD_SESSION_TTL_SECONDS=
TWELVE_DATA_TIMEOUT_SECONDS=15
AI_FLOOR_MARKET_PROVIDER=twelve_data
AI_FLOOR_AI_PROVIDER=deterministic
# xAI Grok (docs/provider_migration.md). Unset keeps the provider above. Exact xai selects Grok and
# does not fall back to OpenAI. Names only; no key values in this file.
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_SECONDS=30
# XAI_RETRIES=2
# XAI_MAX_INPUT_TOKENS=6000
# XAI_MAX_OUTPUT_TOKENS=800
# XAI_MAX_TOTAL_TOKENS=8000
# XAI_RATE_LIMIT_V2=
# Unset or any value other than 1 keeps today's 429 retries. Exact 1 serializes xAI calls
# and retries 429 with backoff, honoring Retry-After up to 60s. Wall clock (HTTP plus
# waits): 90s per call and 180s per cycle, 120s under the 300s watchdog.
# Not set on Render by this change. See docs/provider_migration.md.
AI_FLOOR_MACRO_PROVIDER=none
# official_hybrid existe para evaluación, pero permanece no certificado.
AI_FLOOR_ENABLED_SYMBOLS=XAUUSD,EURUSD
AI_FLOOR_SCHEDULER=0
AI_FLOOR_CLOUD_RUNNER=0
AI_FLOOR_ALERTS_ENABLED=0
AI_FLOOR_SETUP_CHART_EMAIL=0
# Optional read-only dashboard/email cache; blank defaults beside AI_FLOOR_DB_PATH.
AI_FLOOR_CANDLE_CACHE_PATH=
# Broker skeleton (NOT wired; see docs/broker_skeleton.md). Names only, safe defaults OFF.
AI_FLOOR_BROKER_DEMO_ENABLED=
# Read and IGNORED: real broker execution is never enabled by env.
AI_FLOOR_BROKER_REAL_ENABLED=
AI_FLOOR_EMERGENCY_STOP=
AI_FLOOR_BROKER_STATE_DB_PATH=
DXTRADE_BASE_URL=
DXTRADE_USERNAME=
DXTRADE_PASSWORD=
DXTRADE_DOMAIN=
DXTRADE_ACCOUNT_CODE=
# dxtrade (default) | oanda. OANDA practice only (see docs/oanda_adapter.md); the host is hard-coded.
AI_FLOOR_BROKER_DEMO_PROVIDER=
OANDA_PRACTICE_TOKEN=
OANDA_ACCOUNT_ID=
# Broker demo routing (docs/oanda_adapter.md). Default OFF. 1 = REAL orders on the OANDA PRACTICE account.
AI_FLOOR_BROKER_DEMO_ROUTING=
# Opt-in dry-run: 1 = build/log the order JSON, never POST/PUT.
AI_FLOOR_BROKER_DEMO_DRY_RUN=
# Positive int (default 100000).
AI_FLOOR_BROKER_DEMO_MAX_UNITS=
# EURUSD H1 limit pullback on the practice demo. Unset = ON. Exact 0 = immediate market entry (rollback).
# Not a Render change by itself; open positions opened before this tag are left on the previous manager.
AI_FLOOR_EURUSD_LIMIT_PULLBACK=
# Practice-only limit management (DEC-LIMIT-MGMT-1). Unset = current behavior (24h GTD, no cancel/replace).
# Exact 1 = 4h GTD, cancel if price runs 15 pips in favor unfilled, same-side PLAN_READY replaces, EMA entry
# cancels a resting pullback LIMIT. A filled position still blocks. Off again on the next cycle, no redeploy.
AI_FLOOR_LIMIT_MANAGEMENT_V2=
# Practice-only entry offset. Unset or legacy = 12.5 pips. 5pips = 5 pips behind the signal. market = existing
# fill-anchor market order. Anything else is legacy. Independent of the flag above.
AI_FLOOR_ENTRY_OFFSET_MODE=
# EURUSD EMA 10/21 cross (docs/ema_cross.md). Unset = OFF. Exact 1 = demo market entries, SL 20 / TP 40,
# no partials or trail. Does not change the pullback above. Not a Render change by itself.
AI_FLOOR_EMA_CROSS=
# Practice only. Exact 1 = the engine/plan route submits nothing (no pullback LIMIT, no market order) and one
# resting unfilled pullback LIMIT is cancelled (reason EMA_ONLY). EMA, reconcile and management stay as they are.
# Unset or any other value keeps the current route. Not a Render change by itself.
AI_FLOOR_EMA_ONLY=
# DEC-OANDA-ONLY-1: OANDA_DEMO = dashboard / Floor / daily Slack summary show only OANDA demo results (PAPER ledger
# hidden, stays internal). Unset = current behaviour. Not part of the runtime fingerprint.
AI_FLOOR_RESULTS_SOURCE=
# Dashboard Real view: read-only balance (GET summary only; trading stays blocked). Use a read-only token if possible.
OANDA_LIVE_TOKEN=
OANDA_LIVE_ACCOUNT_ID=
# Exness Trader API (docs/exness_api.md). Default broker stays oanda. Names only.
# Real orders need AI_FLOOR_EXNESS_REAL_EXECUTION=1 and AI_FLOOR_EXNESS_REAL_CONFIRM=EXNESS_REAL_AUTHORIZED.
AI_FLOOR_BROKER=
EXN_API_KEY=
EXN_PRIVATE_KEY=
EXN_ACCOUNT_ID=
EXN_DISCOVERY_BASE_URL=
AI_FLOOR_EXNESS_REAL_EXECUTION=
AI_FLOOR_EXNESS_REAL_CONFIRM=
AI_FLOOR_EXNESS_DAILY_LOSS_USD=
AI_FLOOR_EXNESS_MAX_DRAWDOWN_USD=
AI_FLOOR_EXNESS_START_BALANCE=
AI_FLOOR_EXNESS_COMMISSION_PER_LOT_SIDE=
AI_FLOOR_EXNESS_QUOTE_STALE_SECONDS=
AI_FLOOR_EXNESS_MIN_INTERVAL_MS=
AI_FLOOR_EXNESS_STATE_DB_PATH=
AI_FLOOR_EXNESS_RESUME=
