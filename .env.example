OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MASSIVE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FXMACRODATA_API_KEY=
SLACK_WEBHOOK_URL=
GMAIL_APP_PASSWORD=
# Required for email alerts (no built-in default address).
AI_FLOOR_ALERT_EMAIL_FROM=
AI_FLOOR_ALERT_EMAIL_TO=
# At least 12 characters; use a long random value.
AI_FLOOR_DASHBOARD_PASSWORD=
# Optional; default 28800 (8 h), allowed 300..604800.
AI_FLOOR_DASHBOARD_SESSION_TTL_SECONDS=
TWELVE_DATA_TIMEOUT_SECONDS=15
AI_FLOOR_MARKET_PROVIDER=twelve_data
AI_FLOOR_AI_PROVIDER=deterministic
AI_FLOOR_MACRO_PROVIDER=none
# official_hybrid existe para evaluación, pero permanece no certificado.
AI_FLOOR_ENABLED_SYMBOLS=XAUUSD,EURUSD
AI_FLOOR_SCHEDULER=0
AI_FLOOR_CLOUD_RUNNER=0
AI_FLOOR_ALERTS_ENABLED=0
AI_FLOOR_SETUP_CHART_EMAIL=0
# Optional read-only dashboard/email cache; blank defaults beside AI_FLOOR_DB_PATH.
AI_FLOOR_CANDLE_CACHE_PATH=
# Broker skeleton (NOT wired; see docs/broker_skeleton.md). Names only, safe defaults OFF.
AI_FLOOR_BROKER_DEMO_ENABLED=
# Read and IGNORED: real broker execution is never enabled by env.
AI_FLOOR_BROKER_REAL_ENABLED=
AI_FLOOR_EMERGENCY_STOP=
AI_FLOOR_BROKER_STATE_DB_PATH=
DXTRADE_BASE_URL=
DXTRADE_USERNAME=
DXTRADE_PASSWORD=
DXTRADE_DOMAIN=
DXTRADE_ACCOUNT_CODE=
# dxtrade (default) | oanda. OANDA practice only (see docs/oanda_adapter.md); the host is hard-coded.
AI_FLOOR_BROKER_DEMO_PROVIDER=
OANDA_PRACTICE_TOKEN=
OANDA_ACCOUNT_ID=
# Broker demo routing (docs/oanda_adapter.md). Default OFF. 1 = REAL orders on the OANDA PRACTICE account.
AI_FLOOR_BROKER_DEMO_ROUTING=
# Opt-in dry-run: 1 = build/log the order JSON, never POST/PUT.
AI_FLOOR_BROKER_DEMO_DRY_RUN=
# Positive int (default 100000).
AI_FLOOR_BROKER_DEMO_MAX_UNITS=
# DEC-OANDA-ONLY-1: OANDA_DEMO = dashboard / Floor / daily Slack summary show only OANDA demo results (PAPER ledger
# hidden, stays internal). Unset = current behaviour. Not part of the runtime fingerprint.
AI_FLOOR_RESULTS_SOURCE=
# Dashboard Real view: read-only balance (GET summary only; trading stays blocked). Use a read-only token if possible.
OANDA_LIVE_TOKEN=
OANDA_LIVE_ACCOUNT_ID=
