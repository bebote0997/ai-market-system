+def _value(text):
+    """Number big, currency small. Same text, only the unit gets its own span."""
+    raw = MISSING if text is None else str(text)
+    for unit in (" USC", " USD"):
+        if raw.endswith(unit):
+            return f'{_e(raw[:-len(unit)])}<span class="unit">{unit.strip()}</span>'
+    return _e(raw)
